        {"re": "(?:one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|hundred|half|a third|a quarter)(?:[- ](?:one|two|three|four|five|six|seven|eight|nine))?[ \\t]+(?:percent|per cent|in (?:every )?(?:two|three|four|five|ten|\\d+)|out of|of (?:all |the )?(?:cars|drivers|buyers|models|owners|dealers))", "label": "number in words (English)"}
      ],
      "bindings": [
        {"source_path": "fuel.json", "pointer": "^/petrol95$", "about": "95-octane petrol price", "fact_text": "בנזינ|95|petrol", "copy": "בנזינ|95|דלק|ליטר|petrol|fuel"},
        {"source_path": "fuel.json", "pointer": "^/diesel$", "about": "Delek full-service diesel list price (not a national/regulated price)", "fact_text": "סולר", "copy": "שירות מלא", "copy_forbid": "מחיר\\s+(?:ה)?סולר(?!\\s+במחירונ)"},
        {"source_path": "market.json", "pointer": "^/months/", "about": "new private-car deliveries per month", "fact_text": "מסיר|נמסר", "copy": "מסיר|נמסר|חדש"},
        {"source_path": "market.json", "pointer": "^/models/", "about": "deliveries of one model", "fact_text": "מסיר", "copy": "מסיר|נמסר"},
        {"source_path": "model/stats.json", "pointer": "/rcPer$", "about": "active cars of the model listed with an open recall, per 1,000", "fact_text": "ריקול", "copy": "ריקול|recall"},
        {"source_path": "model/stats.json", "pointer": "/act$", "about": "active cars of the model", "fact_text": "פעיל|כביש", "copy": "פעיל|כביש|נוסע|active"}
      ],
      "ignore_patterns": [
        {"name": "reel-spec", "re": "\\(\\d{1,3} שניות, (?:9:16|16:9|1:1|4:5)\\)"},
        {"name": "url", "re": "(?:https?://|www\\.)\\S+"},
        {"name": "luchit-url", "re": "luchit\\.app\\S*"},
        {"name": "windows-path", "re": "[A-Za-z]:\\\\(?:[^\\\\\\n\"'`%]*?\\\\)*[^\\s\\\\\"'`%]*"},
        {"name": "file-name", "re": "[\\w.\\-\\u05D0-\\u05EA]+\\.(?:png|jpe?g|webp|gif|mp4|mov|md|json|html?|py|mjs|js|txt|srt|vtt|woff2|wav|mp3|csv|pdf)\\b"},
        {"name": "asset-id", "re": "\\b[a-z]+(?:-[a-z]+)*-\\d{1,2}\\b"},
        {"name": "kit-folder", "re": "marketing-kit-\\d{4}-\\d{2}-\\d{2}"},
        {"name": "hashtag", "re": "#(?=[\\p{N}_]*\\p{L})[\\p{L}\\p{N}_]+"},
        {"name": "handle", "re": "@[\\w.]+"},
        {"name": "iso-date", "re": "\\d{4}-\\d{2}-\\d{2}(?:T[\\d:.]+Z?)?"},
        {"name": "full-date", "re": "(?<!\\d)(?:0?[1-9]|[12]\\d|3[01])[./](?:0?[1-9]|1[0-2])[./](?:20)?\\d{2}(?![\\d%])"},
        {"name": "day-month", "re": "(?<=(?:ראשון|שני|שלישי|רביעי|חמישי|שישי|שבת|יום|תאריך|עד|מ-|ב-|\\()[^\\n\\d]{0,6})(?:0?[1-9]|[12]\\d|3[01])\\.(?:0[1-9]|1[0-2])(?![\\d%])(?!\\.\\d)(?![ \\t]*(?:%|אחוז|ש\"ח|ש״ח|₪|ליטר|לליטר|ק\"מ))"},
        {"name": "month-year", "re": "(?<!\\d)(?:0?[1-9]|1[0-2])/20\\d{2}(?!\\d)"},
        {"name": "time", "re": "(?<!\\d)(?:[01]?\\d|2[0-3]):[0-5]\\d(?!\\d)"},
        {"name": "aspect-ratio", "re": "(?<![\\d.])(?:9:16|16:9|4:5|5:4|1:1|4:3|3:4|1\\.91:1)(?![\\d.])(?![ \\t]*(?:רכב|דגמ|מסיר|נהג|קונ))"},
        {"name": "dimensions", "re": "(?<![\\d,.])\\d{3,4}\\s*[x×X]\\s*\\d{3,4}(?!\\d)"},
        {"name": "labelled-counter", "re": "(?<!\\p{L})(?:[ובלהמש]{0,2})(?:שקופית|שקופיות|סטורי|מסכ|מסך|slide|story)\\s*-?\\s*\\d{1,2}\\s*(?:/|מתוך|of)\\s*\\d{1,2}(?!\\d)"},
        {"name": "year", "re": "(?<![\\d,.])(?<!כ-?|כ־|~|פי )(?:199\\d|20[0-2]\\d)(?!\\d|[,.]\\d)(?![ \\t]*(?:%|אחוז|ש\"ח|ש״ח|₪|רכב|דגמ|מסיר|ריקול|נהג|בעלי|לקוח|קונ|ק\"מ|קמ|אלף|ליטר|פעמ|מקר))"},
        {"name": "enumeration", "re": "(?:^|(?<=\\|\\s{0,3})|(?<=^#{1,6}\\s{1,3}))\\s*\\d{1,2}[.)](?=\\s)"},
        {"name": "numbered-label", "re": "(?<!\\p{L})(?:[ובלהמש]{0,2})(?:צעד|שלב|פרומפט|שקופית|סטורי|מסך|ערכת תוכן(?: שבועית)?|חלק|תוצר|גרסה|שוט|סצנה|step|slide|prompt|kit|shot|scene|version)\\s*-?\\s*\\d{1,2}(?!\\d)(?![ \\t]*(?:%|אחוז))|(?<!\\p{L})[ובלמש]{0,2}ערכה\\s*-?\\s*\\d{1,2}(?!\\d)(?![ \\t]*(?:%|אחוז|אלף|אלפ|ש\"ח|₪))|(?<!\\p{L})v\\d{1,2}(?!\\d)", "note": "'ערכה 2' (kit 2) is a label; 'הערכה 62' (estimate) is not"},
        {"name": "timecode", "re": "(?<=^\\|\\s{0,3})\\d+(?:\\.\\d+)?\\s*[–-]\\s*\\d+(?:\\.\\d+)?(?:\\s*(?:ש'|שנ'|שניות|s|sec))?(?=\\s*(?:\\(|\\||·|$))"},
        {"name": "ops-count", "re": "(?<![\\d,.])\\d{1,2} (?:התמונות|תמונות|הקבצים|קבצים|השקופיות|שקופיות|הסטוריז|סטוריז|המסכים|מסכים|הפוסטים|פוסטים|התוצרים|תוצרים)(?!\\p{L})"},
        {"name": "model-code", "re": "\\b[A-Z]{1,3}-\\d{1,2}\\b"},
        {"name": "git-sha", "re": "\\b(?=[0-9a-f]*[a-f])[0-9a-f]{7,40}\\b"},
        {"name": "utm-like", "re": "utm_[a-z]+=\\S+"}
      ]
    }
  }
}
