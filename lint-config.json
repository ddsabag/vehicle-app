{
  "_about": "Compliance rules for every לוחית marketing kit (owner: Dudu). lint.mjs reads this file. Text is normalised before matching: niqqud, every invisible/format character (zero-width, bidi, tag characters) removed, final letters unified, Cyrillic/Greek look-alikes folded to Latin, every digit script folded to 0-9, punctuation and spaced letters inside a Hebrew word collapsed, %XX decoded, bidi-override runs also read reversed. A term is either a string (whole word; Hebrew gets optional prefixes ו/ה/ש/ב/ל/מ/כ, up to 4) or {re} (a regex on the normalised text: lower case, final letters as regular letters, {P} = the prefix group; wrapped in letter boundaries unless bounded:false) with optional unless_prev / unless_next / unless_match. Red-team: extend the lists and add a fixture to fixtures/selftest-cases.json for each new entry.",
  "version": 2,
  "scan": {
    "html_ext": [".html", ".htm", ".xhtml", ".svg", ".xml"],
    "md_ext": [".md", ".markdown"],
    "json_ext": [".json"],
    "code_ext": [".js", ".mjs", ".cjs", ".ts", ".py"],
    "text_ext": [".txt", ".srt", ".vtt", ".yml", ".yaml", ".csv", ".tsv", ".ass", ".ssa", ".sbv", ".lrc", ".ini", ".toml", ".sub"],
    "binary_ext": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".avif", ".ico", ".bmp", ".mp4", ".mov", ".webm", ".mkv", ".m4v", ".mp3", ".wav", ".m4a", ".aac", ".ogg", ".flac", ".woff", ".woff2", ".ttf", ".otf", ".pdf", ".zip", ".pyc"],
    "skip_dirs": ["node_modules", "vendor", ".git", "__pycache__", ".hyperframes"],
    "facts_file": "facts.json",
    "plates_only_files": ["facts.json", "ideas.json", "package.json", "package-lock.json"],
    "json_skip_keys": ["at", "until", "targets", "needs_live", "cover", "link", "step", "emoji", "cls", "file", "files", "src", "path", "id", "template", "type", "bg", "color", "class", "style", "font", "size", "width", "height", "utm", "url", "href", "slug", "fps", "duration", "start", "end", "x", "y", "w", "h", "z", "scale", "opacity", "ease", "delay"],
    "_json_skip_keys_note": "values of these keys are not checked against facts.json, but every word/plate rule still runs on them. A value that does not fit json_skip_key_values (e.g. a 'step' that is not a 1-2 digit counter) is checked as copy.",
    "json_skip_key_values": {"step": "^\\s*\\d{1,2}\\s*$"},
    "nonum_allowed": "^\\s*(?:\\d{1,2}(?:\\s*/\\s*\\d{1,2})?)?\\s*$",
    "_nonum_note": "HTML elements marked data-nonum (slide counters '2/5', decorative step numbers '3') are skipped by the number check only when their text fits nonum_allowed.",
    "max_bytes": 50000000,
    "banned_sha256": ["ebee57bdad7d03cd147b537b510ae279baca5927b49ef3a4ab9d147bd89a0cb6"],
    "_banned_sha256_note": "marketing-video/short-1-oketz.mp4 (any copy of it in the kit fails, whatever its name)"
  },
  "kit_md_regex": "^ערכת-תוכן-שבועית-\\d+\\.md$",
  "measurement_section_regex": "^(?:\\d+[.)]\\s*)?(?:מדידה|measurement)\\s*$",
  "rules": {
    "forbidden-word": {
      "he": "מילה אסורה בתוכן שיווקי של לוחית",
      "en": "Forbidden word in לוחית marketing copy",
      "terms": [
        {"re": "{P}רמא(?:י|ית|ים|יות|ות)\\p{L}*", "label": "רמאי/רמאות"},
        {"re": "{P}רמיי?(?:ה|ת)", "label": "רמייה"},
        {"re": "{P}(?:עוקצ|עקצ|עקיצ)\\p{L}*", "label": "עוקץ/עקץ"},
        {"re": "{P}[לנית]עקו?צ\\p{L}*", "label": "לעקוץ/נעקץ"},
        {"re": "{P}נוכל(?:ים|ת|ות|י|יי?ה|יות)\\p{L}*", "label": "נוכלים"},
        {"re": "{P}נוכל", "label": "נוכל", "note": "allowed only as the verb 'we will be able': before an infinitive (נוכל לבדוק, נוכל גם לבדוק) or after אם/ביחד/לא/אנחנו... (אם נוכל, ביחד נוכל.)",
         "unless_next": "(?:ל(?!א(?!\\p{L})|מדי(?!\\p{L})|גמרי(?!\\p{L})|חלוטינ(?!\\p{L})|כל(?!\\p{L}))\\p{L}{2,}|(?:גמ|ממש|כבר|אולי|רק|יחד|ביחד|תמיד|עוד|באמת|בקלות|אז)(?:[^\\p{L}]+\\p{L}+)?[^\\p{L}]+ל\\p{L}{2,})",
         "unless_prev": "(?<!\\p{L})(?:אמ|ואמ|ביחד|יחד|ככ|ככה|אז|לא|גמ|אנחנו|אנו|איכ|מתי|כיצד|רק|כבר|אולי|עכשיו|כולנו)[^\\p{L}]*$"},
        {"re": "{P}(?:חשיפ\\p{L}*|חושפ\\p{L}*|נחשפ\\p{L}*|חשפ\\p{L}*|[לנית]חשו?פ\\p{L}*)", "label": "חשיפה/לחשוף", "metric_ok": true, "note": "allowed only in the measurement section (impressions as a metric)"},
        {"re": "{P}מציא(?:ה|ות|ותי|ותיו|ותינו|ותכמ|ותיהמ)", "label": "מציאה", "unless_match": "(?:ו|ש|וש|כש)?(?:ה|ב)מציאות", "note": "המציאות / במציאות (reality) are allowed"},
        {"re": "{P}מציאות(?=[^\\p{L}]+(?:של[^\\p{L}]+)?(?:ה?שבוע|ה?חודש|ה?שנה|ממש|ב?מחיר\\p{L}*|לסוחרימ|במגרש|ה?אמיתיות))", "label": "מציאות (bargains)"},
        {"re": "{P}(?:משתלמ\\p{L}*|[יתנ]שתלמ\\p{L}*|השתלמ(?:ה|ו)?)", "label": "משתלם", "unless_prev": "(?<!\\p{L})(?:לא|ממש לא|כלל לא|אינו|אינה|אינמ|אינני)[ \\t]+$"},
        {"re": "{P}מומלצ\\p{L}*", "label": "מומלץ", "unless_prev": "(?<!\\p{L})(?:לא|ממש לא|כלל לא|אינו|אינה|אינמ|אינני)[ \\t]+$", "note": "negated safety advice ('לא מומלץ לנסוע עם ריקול פתוח') is allowed"},
        {"re": "{P}(?:ממליצ\\p{L}*|המלצ\\p{L}*|[לנית]?המליצ\\p{L}*|[אנית]מליצ\\p{L}*)", "label": "ממליצים/המלצה"},
        "הכי טוב", "הכי טובה", "הכי טובים", "הכי טובות",
        {"re": "scam\\p{L}*", "label": "scam"}, {"re": "fraud\\p{L}*", "label": "fraud"}, {"re": "crook\\p{L}*", "label": "crook"},
        {"re": "bargain\\p{L}*", "label": "bargain"}, {"re": "recommend\\p{L}*", "label": "recommend"}, {"re": "rip[- ]?offs?", "label": "rip-off"},
        {"re": "swindl\\p{L}*", "label": "swindle"}, {"re": "con[- ]?(?:man|men|artists?)", "label": "con man"}, {"re": "cheat\\p{L}*", "label": "cheat"}
      ]
    },
    "winner-or-recommendation": {
      "he": "ניסוח שמכריז על רכב כמציאה/מומלץ או על מנצח בהשוואה",
      "en": "Wording that labels a car a bargain/recommended or declares a winner",
      "terms": [
        {"re": "{P}ה(?:טוב|אמינ|בטוח|זול|משתלמ|כדאי|שווה|איכותי|מוצלח|חסכוני|חכמ|נכונ|יעיל|מומלצ|אהוב)\\p{L}*[^\\p{L}]+ביותר", "label": "ה... ביותר"},
        {"re": "{P}הכי[^\\p{L}]+(?:טוב|אמינ|בטוח|זול|משתלמ|כדאי|שווה|איכותי|מוצלח|חסכוני|חכמ|נכונ|יעיל|מומלצ|אהוב)\\p{L}*", "label": "הכי ..."},
        {"re": "{P}(?:טוב|טובה|טובימ|טובות)[^\\p{L}]+יותר|{P}יותר[^\\p{L}]+(?:טוב|טובה|טובימ|טובות)", "label": "טוב יותר"},
        {"re": "{P}(?:אמינ|אמינה|אמינימ|בטוח|בטוחה|חסכוני|חסכונית|מוצלח|מוצלחת|איכותי|איכותית|זול|זולה|משתלמ\\p{L}*)[^\\p{L}]+יותר[^\\p{L}]+מ\\p{L}+|{P}יותר[^\\p{L}]+(?:אמינ|אמינה|בטוח|בטוחה|חסכוני|חסכונית|מוצלח|מוצלחת|איכותי|איכותית|זול|זולה)[^\\p{L}]+מ\\p{L}+", "label": "X יותר מ-Y"},
        {"re": "{P}עדיפ(?:ה|ימ|ות)?[^\\p{L}]+(?:על|מ\\p{L}+)", "label": "עדיף על"},
        {"re": "{P}(?:מנצח\\p{L}*|ניצח\\p{L}*|נצחונ\\p{L}*|ניצחונ\\p{L}*)", "label": "מנצח/ניצחון", "unless_prev": "(?<!\\p{L})(?:אינ|בלי|ללא)(?:[ \\t]+(?:כאנ|פה|שומ))?[ \\t]+$", "note": "'אין מנצח' / 'השוואה בלי מנצח' (no-winner framing) is allowed"},
        {"re": "{P}(?:ה)?מקומ[^\\p{L}]+(?:ה)?(?:ראשונ|1(?!\\d))", "label": "מקום ראשון"},
        {"re": "{P}מספר[^\\p{L}\\d]+(?:1|אחת|אחד)(?![\\d.,])[^\\p{L}]+(?:ב\\p{L}+|של)", "label": "מספר 1 ב..."},
        {"re": "(?<![\\p{L}\\p{N}])(?:#|מס'?|no\\.?)[ \\t]?1(?![\\p{L}\\p{N}.,_])", "bounded": false, "label": "#1"},
        {"re": "{P}(?:דיל|דילימ)", "label": "דיל"},
        {"re": "{P}שווה[^\\p{L}]+כל[^\\p{L}]+(?:שקל|אגורה|גרוש)", "label": "שווה כל שקל"},
        {"re": "{P}(?:הזדמנות[^\\p{L}]+(?:של[^\\p{L}]+פעמ|פז|שאסור|שאי אפשר|שלא כדאי)|אסור[^\\p{L}]+לפספס|חובה[^\\p{L}]+לקנות|לא[^\\p{L}]+תמצאו[^\\p{L}]+(?:מחיר|רכב|עסקה))", "label": "הזדמנות שאסור לפספס"},
        {"re": "{P}(?:בחירת[^\\p{L}]+(?:ה)?(?:עורכ|מערכת)|הבחירה[^\\p{L}]+(?:שלנו|שלי|הנכונה|הטובה|החכמה))", "label": "הבחירה שלנו"},
        "עדיף לקנות", "כדאי לקנות", "שווה לקנות", "שווה את הכסף",
        "עסקה מצוינת", "עסקה טובה", "עסקת השנה", "רכב הזדמנות", "מחיר מציאה", "מחיר הזדמנות",
        {"re": "best[- ]?(?:buy|deal|car|choice|value|pick)s?|top[- ]?(?:pick|rated|choice)s?|editor'?s'?[- ](?:choice|pick)|must[- ]?(?:buy|have)|great deal|deal of the (?:day|week|month)|winners?|wins|steal of|cheapest|most reliable|safest|number one|best", "label": "best/winner (English)", "unless_next": "(?:time|way|moment|day|hour|place|practice|to check|of luck)(?!\\p{L})", "unless_prev": "(?<!\\p{L})(?:no|not the)[ \\t]+$"}
      ]
    },
    "golden-rule": {
      "he": "חוק הזהב: סוחרים, טרייד-אין, יבואנים ומנהלי ציים הם לקוחות. אין חשיפת רמאות, אין זיהוי סוחרים, אין הצגה שלילית",
      "en": "Golden rule: dealers/trade-in/importers/fleet managers are customers; no fraud-exposing, dealer-identifying or negative framing",
      "terms": [
        "סוחרים מסתירים", "הסוחר מסתיר", "הסוחרים מסתירים", "המוכר מסתיר", "המוכרים מסתירים", "מסתירים ממך", "מסתירים מכם", "מסתיר ממך", "מסתיר מכם",
        "יבואנים מסתירים", "היבואן מסתיר", "היבואן לא סיפר", "היבואן לא יספר",
        "המוכר שיקר", "הסוחר שיקר", "שיקרו לך", "משקרים לך",
        "הסוחר לא סיפר", "המוכר לא סיפר", "הסוחר לא יספר", "המוכר לא יספר", "לא יספרו לך", "מה שהסוחר לא", "מה שהמוכר לא", "מה שהיבואן לא",
        "עבדו עליך", "עבדו עליכם", "לעבוד עליך", "לעבוד עליכם", "יעבדו עליך", "יעבדו עליכם",
        "לא ימכרו לך לימון",
        "סוחר רמאי", "סוחר נוכל", "סוחרים נוכלים", "סוחר ממולח",
        "אל תסמכו על הסוחר", "אל תסמוך על הסוחר", "אל תאמינו לסוחר", "אל תאמין לסוחר", "אל תאמינו למוכר", "אל תאמין למוכר",
        "תפסו את הסוחר", "לתפוס את הסוחר", "תופסים את הסוחר",
        "לזהות סוחר", "לזהות סוחרים", "מזהה סוחר", "מזהה סוחרים", "מזהה את הסוחר", "זיהוי סוחר", "זיהוי סוחרים",
        "גלגול מונה", "גלגלו את המונה", "מונה מגולגל", "מזויף", "מזויפת",
        {"re": "{P}לימונ(?:ימ)?", "label": "לימון", "unless_prev": "(?<!\\p{L})(?:צהוב|צהובה|צהובימ|בצבע|צבע|ירוק|ירוקה|גוונ|מיצ|טעמ|ריח|פרוסת|קליפת)[ \\t]+$", "unless_next": "(?:צהוב|ירוק|מטאלי|מטלי|metallic|yellow)"},
        {"re": "lemons?", "label": "lemon", "unless_next": "(?:yellow|zest|juice|green)", "unless_prev": "(?<!\\p{L})(?:yellow|colou?r)[ \\t]+$"},
        {"re": "{P}הונא(?:ה|ות|ת)", "label": "הונאה", "unless_prev": "(?<!\\p{L})ו?אינ(?:[ \\t]+(?:פה|כאנ|שומ))?[ \\t]+$", "note": "'אין פה הונאה' is allowed"},
        {"re": "{P}(?:לרמות|מרמה|מרמות)", "label": "לרמות/מרמה", "unless_next": "(?:שיא|ה?גבוה\\p{L}*|ה?נמוכ\\p{L}*|ה?חדש\\p{L}*|ה?קודמ\\p{L}*|ה?דומ\\p{L}*|של|שלא|ה?סביר\\p{L}*|מחיר\\p{L}*|ה?ביקוש|ה?היצע|ה?מכירות|ה?מסירות|אחרת|אחרות|זו|זאת|כזו|כזאת|מקצועי\\p{L}*|ה?גבוהה|\\d)", "note": "'לרמות שיא' / 'מרמה גבוהה' (levels) are allowed"},
        {"re": "{P}(?:מרמימ|רימו|ירמו|ירמה|תרמו)", "label": "מרמים/רימו"},
        {"re": "{P}(?:רימה|לרמות|מרמה)[^\\p{L}]+(?:אות\\p{L}*|את[^\\p{L}]+\\p{L}+|קונימ|קונה|לקוחות|לקוח)", "label": "לרמות את..."},
        {"re": "{P}חשוד(?:ה|ימ|ות)?", "label": "חשוד", "unless_prev": "(?<![\\p{L}])(?:ו?לא|אינו|איננו|אינה|אינמ)[ \\t]+$", "note": "only 'לא החשוד' directly negated (no punctuation, not 'שלא') is allowed"},
        {"re": "{P}(?:חשד\\p{L}*|[לנית]?חושד\\p{L}*|לחשוד|חשדנ\\p{L}*)", "label": "חשד/חושדים"},
        {"re": "{P}(?:הסתיר\\p{L}*|[ימנת]סתיר\\p{L}*|להסתיר|מוסתר\\p{L}*|[ימנת]?סתירו)", "label": "הסתיר/מסתיר"},
        {"re": "{P}(?:שיקר\\p{L}*|משקר\\p{L}*|[ינת]שקר\\p{L}*|לשקר|שקרנ\\p{L}*|שקר|שקרימ)", "label": "משקר/שקר"},
        {"re": "{P}ידע[^\\p{L}]+ו?שתק", "label": "ידע ושתק"},
        {"re": "{P}(?:לא|ולא)[^\\p{L}]+(?:סיפר\\p{L}*|מספר(?:ימ|ת)|יספר\\p{L}*|גילו|גילה|יגלו|יגלה|מגלימ|אמרו|יאמרו|ציינו)[^\\p{L}]+(?:לכ|לכמ|לכנ|לקונה|לקונימ|ללקוח|ללקוחות|את[^\\p{L}]+(?:כל[^\\p{L}]+)?ה?אמת)", "label": "לא סיפרו לך"},
        {"re": "{P}(?:סידרו|סידר|דפקו|דפק|הפילו|עבדו|עבד|גנבו|גנב|ניצלו|ניצל|עקצו|עקצ)[^\\p{L}]+(?:אות(?:כ|כמ|כנ|ו|נו)|עליכ|עליכמ|ממכ|מכמ)", "label": "סידרו אותך"},
        {"re": "{P}(?:פראייר\\p{L}*|פרייאר\\p{L}*|פרייר\\p{L}*|פראיר\\p{L}*)", "label": "פראייר"},
        {"re": "{P}(?:תחמנ\\p{L}*|נוכלות)", "label": "תחמן"},
        {"re": "{P}הטעי(?:י)?(?:ה|ות|ת)|{P}(?:להטעות|מטעה|מטעימ|הטעו|הטעה)", "label": "הטעיה/מטעה"},
        {"re": "{P}(?:לאתר|מאתר\\p{L}*|איתור|תאתרו|לחשוף|לזהות|מזהה|מזהימ|זיהוי|לתפוס|תופס\\p{L}*)[^\\p{L}]+(?:\\p{L}+[^\\p{L}]+)?(?:ה)?(?:סוחר|מוכר|יבואנ|מגרש)\\p{L}*", "label": "לאתר/לזהות סוחרים"},
        {"re": "shady|dodgy|sketchy|dishonest", "label": "shady"}
      ],
      "pairs": [
        {"label": "dealer + negative framing",
         "a": "{P}(?:סוחר\\p{L}*|מוכר(?:ימ|ת|ות)?|יבואנ\\p{L}*|טרייד[^\\p{L}]?אינ|מגרש\\p{L}*|ליסינג|ציי?מ?|dealer\\p{L}*|seller\\p{L}*|importer\\p{L}*)",
         "b": "{P}(?:בעייתי\\p{L}*|ממולח\\p{L}*|מפוקפק\\p{L}*|חשוד\\p{L}*|שתק\\p{L}*|ישתוק|ישתקו|להיפטר|נפטר\\p{L}*|יפטר\\p{L}*|מעלימ\\p{L}*|העלימ\\p{L}*|מטשטש\\p{L}*|תחמנ\\p{L}*|גנב\\p{L}*|מנצל\\p{L}*|hide\\p{L}*|hid|hidden|lie|lies|lied|lying|liar\\p{L}*|cheat\\p{L}*|trick\\p{L}*)",
         "within_words": 6,
         "b_unless_prev": "(?<!\\p{L})(?:ו?לא|אינו|אינמ)[ \\t]+$"}
      ]
    },
    "entitled-claim": {
      "he": "\"זכאי\" / \"מגיע לכם\" אסור בטענות על ריקולים/הסדרים; לכתוב \"ייתכן\" / \"בדרך כלל\"",
      "en": "\"entitled\" is forbidden in recall/settlement claims; hedge with \"ייתכן\"",
      "terms": [
        {"re": "{P}זכא\\p{L}*", "label": "זכאי"},
        {"re": "{P}(?:מגיע|מגיעה|מגיעימ)[^\\p{L}]+(?:לכ|לכמ|לכנ|לו|לה|להמ|לנו|לבעלי)", "label": "מגיע לכם"},
        {"re": "{P}(?:זכות|זכויות)(?:[^\\p{L}]+(?:שלכ|שלכמ|שלכנ|שלו|שלה|שלהמ))?", "label": "הזכות שלכם"},
        {"re": "zaka'?(?:i|it|im|iot|ut)\\p{L}*|zchaut|entitled|entitlement|eligible|eligibility|you deserve|you are owed|owed to you", "label": "entitled (latin)"}
      ],
