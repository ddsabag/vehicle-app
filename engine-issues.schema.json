{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luchit.app/engine-issues.schema.json",
  "title": "ספריית תקלות מנוע ומכלולים ידועות (לוחית)",
  "description": "כל פריט מגובה במקור רשמי. המפתח לרכב: קוד מנוע (degem_manoa כפי שהוא ברישום) ונפח מנוע בסמ״ק. כינוי מסחרי לא משמש להתאמה.",
  "type": "object",
  "required": ["version", "updated", "issues"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "updated": {"type": "string", "format": "date"},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
  },
  "$defs": {
    "issue": {
      "type": "object",
      "required": ["id", "engine", "title", "summary", "severity", "status", "sources", "reviewed"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,60}$", "description": "מזהה קבוע, לא משתנה אחרי פרסום (משמש להתראות ולאנליטיקה)"},
        "engine": {
          "type": "object",
          "required": ["family", "codes", "cc"],
          "additionalProperties": false,
          "properties": {
            "family": {"type": "string", "description": "שם תצוגה, למשל PureTech 1.2 (EB2)"},
            "codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}, "description": "קודי degem_manoa בדיוק כפי שהם במאגר משרד התחבורה. ההשוואה מתעלמת מרווחים, מקפים ונקודות ומאותיות גדולות/קטנות"},
            "cc": {"type": "object", "required": ["min", "max"], "additionalProperties": false, "properties": {"min": {"type": "integer", "minimum": 0}, "max": {"type": "integer", "minimum": 0}}, "description": "טווח נפח בסמ״ק (למשל 1199 עד 1199). רכב בלי נפח ברישום לא מותאם"},
            "fuel": {"type": "array", "items": {"type": "string"}, "description": "אופציונלי: סוג דלק כפי שברישום (בנזין, דיזל...). ריק = כל סוג"},
            "makers": {"type": "array", "items": {"type": "string"}, "description": "אופציונלי: מילת יצרן בעברית כפי שהיא ב-tozeret_nm (פיג'ו, סיטרואן). מגן מפני קוד מנוע זהה אצל יצרן אחר"},
            "years": {"type": "object", "additionalProperties": false, "properties": {"from": {"type": "integer", "minimum": 1990}, "to": {"type": "integer", "minimum": 1990}}, "description": "אופציונלי: שנות ייצור (shnat_yitzur) שהבעיה חלה עליהן"}
          }
        },
        "title": {"type": "string", "minLength": 5, "maxLength": 90, "description": "שם התקלה, למשל: התפוררות רצועת תזמון שטובלת בשמן"},
        "summary": {"type": "string", "minLength": 20, "maxLength": 500, "description": "מה קורה ולמה זה חשוב, בלי לטעון יותר ממה שכתוב במקורות"},
        "symptoms": {"type": "array", "items": {"type": "string"}, "maxItems": 5},
        "severity": {"enum": ["high", "medium", "low"], "description": "high = עלול לגרום לנזק מנוע או לסכנה; medium = תיקון יקר בלי סכנה; low = מטרד"},
        "status": {"enum": ["extended_warranty", "recall", "court_ruling", "class_action_approved", "class_action_pending", "manufacturer_notice", "regulator_notice", "fixed_in_production"]},
        "statusText": {"type": "string", "maxLength": 160, "description": "פירוט הסטטוס, למשל: הוארכה האחריות על הרצועה"},
        "statusUntil": {"type": "string", "format": "date", "description": "אופציונלי: עד מתי ההטבה בתוקף. אחרי התאריך הכרטיס מציין שהמועד עבר"},
        "advice": {"type": "string", "maxLength": 300, "description": "מה לעשות, למשל: בקשו מהמוכר חשבונית החלפת רצועה"},
        "sources": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type", "title", "url", "date"],
            "additionalProperties": false,
            "properties": {
              "type": {"enum": ["court_ruling", "class_action", "manufacturer_notice", "importer_notice", "recall", "regulator"]},
              "title": {"type": "string"},
              "publisher": {"type": "string"},
              "url": {"type": "string", "pattern": "^https://"},
              "archive": {"type": "string", "pattern": "^https://", "description": "אופציונלי: עותק בארכיון (web.archive.org) למקרה שהמקור יוסר"},
              "date": {"type": "string", "format": "date"}
            }
          }
        },
        "reviewed": {"type": "object", "required": ["date", "by"], "additionalProperties": false, "properties": {"date": {"type": "string", "format": "date"}, "by": {"type": "string"}}}
      }
    }
  }
}
