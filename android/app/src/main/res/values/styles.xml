<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="band">#14213D</color>
    <color name="brand">#FFC400</color>
    <color name="plate">#F6C500</color>
    <!-- the page's own background (its bg token in index.html), light and dark: the splash and the window show it until the page has drawn -->
    <color name="page_light">#F2F4F8</color>
    <color name="page_dark">#0E121A</color>
    <!-- the page's accent token, light and dark: Android's own pickers that the page opens (a date, a <select>) mark the choice and their
         buttons in it, as the page does; the plate's yellow under white text, or as text on white, cannot be read -->
    <color name="accent_light">#2457C5</color>
    <color name="accent_dark">#7EA3F2</color>

    <!-- the bars are transparent: they show the window's background, which MainActivity paints in the colours of the page's edges -->
    <style name="Base.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:isLightTheme">true</item>
        <item name="android:windowBackground">@color/page_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/accent_light</item>
    </style>
    <style name="Base.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:isLightTheme">false</item>
        <item name="android:windowBackground">@color/page_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/accent_dark</item>
    </style>

    <!-- the app's theme (manifest): light, like the page's own default -->
    <style name="AppTheme" parent="Base.Light" />
    <!-- the page set to "כהה", and to "לפי המכשיר" (values-night has its dark side): MainActivity takes the one the page chose before its
         window is made, and on Android 13 and later the splash screen of the next launch is the same (MainActivity.themeChosen) -->
    <style name="AppTheme.Dark" parent="Base.Dark" />
    <style name="AppTheme.DayNight" parent="Base.Light" />
</resources>
